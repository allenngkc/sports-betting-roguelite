{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/figures/**",
              "components/form/**",
              "components/margin/**",
              "components/os-chrome/**",
              "components/records/**",
              "components/tv/**",
              "ui_kits/surething/**",
              "ui_kits/tv-sweat/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Archivo Narrow|Encode Sans|Encode Sans Condensed))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Archivo Narrow, Encode Sans, Encode Sans Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:no|matchup|price|more|style|key|ref|className|style|children)$/]",
        "message": "<ColumnHead> doesn't accept that prop. Declared props: no, matchup, price, more, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormTeam'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|record|price|key|ref|className|style|children)$/]",
        "message": "<FormTeam> doesn't accept that prop. Declared props: name, record, price."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|width|height|base|style|key|ref|className|style|children)$/]",
        "message": "<InkMark> doesn't accept that prop. Declared props: variant, color, width, height, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LedgerEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|legs|terminal|stake|payout|style|key|ref|className|style|children)$/]",
        "message": "<LedgerEntry> doesn't accept that prop. Declared props: number, legs, terminal, stake, payout, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LedgerEntry'] > JSXAttribute[name.name='terminal'] > Literal[value!=/^(?:WON|LOST|CASHED OUT|VOIDED)$/]",
        "message": "<LedgerEntry> terminal must be one of 'WON' | 'LOST' | 'CASHED OUT' | 'VOIDED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LockAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|disabled|reason|onClick|style|key|ref|className|style|children)$/]",
        "message": "<LockAction> doesn't accept that prop. Declared props: label, disabled, reason, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarginHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|style|key|ref|className|style|children)$/]",
        "message": "<MarginHeader> doesn't accept that prop. Declared props: title, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarginLeg'] > JSXAttribute > JSXIdentifier[name!=/^(?:team|price|market|entry|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<MarginLeg> doesn't accept that prop. Declared props: team, price, market, entry, onRemove, style."
